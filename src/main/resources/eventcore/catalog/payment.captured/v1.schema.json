{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["paymentId", "orderId", "amount", "currency"],
  "properties": {
    "paymentId": { "type": "string", "minLength": 1, "maxLength": 64 },
    "orderId": { "type": "string", "minLength": 1, "maxLength": 64 },
    "amount": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,15})([.][0-9]{1,4})?$" },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "method": { "enum": ["CARD", "PIX", "BANK_TRANSFER"] }
  }
}
