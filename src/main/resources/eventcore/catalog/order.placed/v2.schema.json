{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["orderId", "customerId", "total", "items"],
  "properties": {
    "orderId": { "type": "string", "minLength": 1, "maxLength": 64 },
    "customerId": { "type": "string", "minLength": 1, "maxLength": 64 },
    "total": { "$ref": "#/$defs/money" },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sku", "quantity", "unitPrice"],
        "properties": {
          "sku": { "type": "string", "minLength": 1, "maxLength": 64 },
          "quantity": { "type": "integer", "minimum": 1 },
          "unitPrice": { "$ref": "#/$defs/money" }
        }
      }
    }
  },
  "$defs": {
    "money": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "currency"],
      "properties": {
        "amount": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,15})([.][0-9]{1,4})?$" },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
      }
    }
  }
}
